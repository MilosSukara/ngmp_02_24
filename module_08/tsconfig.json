{
    "compilerOptions": {
        "module": "NodeNext",
        "target": "es2020",
        "moduleResolution": "NodeNext",
        "declaration": true,
        "outDir": "./dist/",
        "esModuleInterop": true,
        "strict": true,
        "experimentalDecorators": true,
        "emitDecoratorMetadata": true
    },
    "include": [
        "./src"
    ],
    "exclude": [
        "node_modules"
    ]
}